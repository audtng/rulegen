+
+var _ types.XDSHookClient = (*mockXDSHookClient)(nil)
+
+func (m *mockXDSHookClient) PostRouteModifyHook(r *route.Route, hostnames []string, resources []*unstructured.Unstructured) (*route.Route, error) {
