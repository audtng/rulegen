+	for _, ext := range exts {
+		mgr := &Manager{
+			extension:          *ext,
+			extensionConnCache: conn,
+		}
+		resourceGKSet, policyGKSet := buildManagerGKSets(ext)
+		named = append(named, namedManager{
+			name:            ext.Name,
+			manager:         mgr,
+			resourceGKSet:   resourceGKSet,
+			policyGKSet:     policyGKSet,
+			cleanupHookConn: cleanup,
+		})
+	}
