+func TestCopyNoFollowRejectsDirectory(t *testing.T) {
+	dir := t.TempDir()
+	src := filepath.Join(dir, "adir")
+	require.NoError(t, os.Mkdir(src, 0o700))
+	dst := filepath.Join(dir, "dst")
+
+	err := copyNoFollow(src, dst, 0o600)
+	require.Error(t, err)
+	assert.NoFileExists(t, dst)
+}
