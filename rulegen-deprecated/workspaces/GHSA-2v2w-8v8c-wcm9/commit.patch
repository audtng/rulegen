+		return cached, nil
+	}
+
+	// Create new dialHolder
+	clusterDialer, err := f.ClusterDialer(clusterName, retryOnError)
+	if err != nil {
+		return nil, err
+	}
+	dialHolder := &transport.DialHolder{Dial: clusterDialer}
+
+	// Save in the cache
+	f.dialHolders[clusterName] = dialHolder
+
+	return dialHolder, nil
