-	}
-	return newAnnos
+	filteredAnnotations := maps.Clone(annotations)
+	maps.DeleteFunc(filteredAnnotations, func(key string, value string) bool {
+		return strings.HasPrefix(key, prefix)
+	})
+	return filteredAnnotations
 }
