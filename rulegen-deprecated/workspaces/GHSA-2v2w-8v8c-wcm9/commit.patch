+		loggingChart, err := extensionscharts.GetChartStatus(client, project.ClusterID, charts.RancherLoggingNamespace, charts.RancherLoggingName)
+		require.NoError(t, err)
+
+		if !loggingChart.IsAlreadyInstalled {
