+			v.T().Logf("Error executing script on pod %s: %v", pod, err)
+			continue
+		}
+		v.T().Logf("Command executed successfully on pod %s", pod)
+
+		outputs = append(outputs, fmt.Sprintf("Output from pod %s:\n%s", pod, output))
