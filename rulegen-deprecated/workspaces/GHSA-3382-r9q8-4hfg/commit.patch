+func copyAvailAddresses(a map[string][]NodeNetworkAddress) map[string][]NodeNetworkAddress {
+	l := len(a)
+	if l == 0 {
+		return nil
+	}
+
+	c := make(map[string][]NodeNetworkAddress, l)
+	for k, v := range a {
