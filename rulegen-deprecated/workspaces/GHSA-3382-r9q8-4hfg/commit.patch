+		}
+		return childMax, nil
+	case SC_CLK_TCK:
+		return _SYSTEM_CLK_TCK, nil
+	case SC_DELAYTIMER_MAX:
+		return _DELAYTIMER_MAX, nil
+	case SC_GETGR_R_SIZE_MAX:
