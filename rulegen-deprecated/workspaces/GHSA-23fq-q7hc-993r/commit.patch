+		"uppercase": {
+			input:    "FOOBAR",
+			expected: "foobar",
+		},
+		"mixed case": {
+			input:    "fOoBaR",
+			expected: "foobar",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			actual := lowercase(test.input)
