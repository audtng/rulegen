+			},
+			expected: map[string]interface{}{
+				"foo": int64(42),
+			},
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			actual := copyMap(test.input)
+			coerceFloatsToInt(actual)
+			if !reflect.DeepEqual(actual, test.expected) {
