+func (f *recordingDatabase) Initialize(ctx context.Context, req InitializeRequest) (InitializeResponse, error) {
+	f.initializeCalls++
+	if f.next == nil {
+		return InitializeResponse{}, nil
+	}
+	return f.next.Initialize(ctx, req)
