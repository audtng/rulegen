+	// Ensure only the selected one is on logins.
+	// They both should now appear on the login.
+	resp, err = e.backend.HandleRequest(e.ctx, &logical.Request{
+		Operation: logical.UpdateOperation,
+		Path:      "login",
+		Storage:   e.storage,
+		Connection: &logical.Connection{
