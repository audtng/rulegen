+
+func (e *environment) TestOnlyNonDefaultsCanBeSelected(t *testing.T) {
+	// Omit all default fields and just select one.
+	resp, err := e.backend.HandleRequest(e.ctx, &logical.Request{
+		Operation: logical.UpdateOperation,
+		Path:      "config",
