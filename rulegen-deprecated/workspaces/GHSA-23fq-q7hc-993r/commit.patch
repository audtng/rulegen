+
+func BenchmarkParser_Parse(b *testing.B) {
+	config := `length = 20
+               rule "charset" {
+                   charset = "abcde"
+                   min-chars = 2
+               }`
+
+	for i := 0; i < b.N; i++ {
+		parser := PolicyParser{
+			RuleRegistry: Registry{
+				Rules: defaultRuleNameMapping,
