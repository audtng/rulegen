+	out, err := os.Create(filepath.Join(c.flagOutput, "vault.log"))
+	if err != nil {
+		c.captureError("log", err)
+		return
+	}
+	defer out.Close()
+
+	logCh, err := c.cachedClient.Sys().Monitor(ctx, "trace")
+	if err != nil {
+		c.captureError("log", err)
+		return
+	}
+
+	for {
+		select {
+		case log := <-logCh:
+			_, err = out.WriteString(log)
+			if err != nil {
+				c.captureError("log", err)
+				return
+			}
+		case <-ctx.Done():
+			return
+		}
+	}
+}
