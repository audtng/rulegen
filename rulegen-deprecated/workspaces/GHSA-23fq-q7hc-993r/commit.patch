+			logical.UpdateOperation: &framework.PathOperation{
+				Callback: b.pathConfigTidyRoletagDenyListCreateUpdate,
+			},
+			logical.ReadOperation: &framework.PathOperation{
+				Callback: b.pathConfigTidyRoletagDenyListRead,
