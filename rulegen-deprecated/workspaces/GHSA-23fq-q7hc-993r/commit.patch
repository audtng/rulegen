+func TestBoltSetAutoAuthToken(t *testing.T) {
+	ctx := context.Background()
+
+	path, err := ioutil.TempDir("", "bolt-test")
+	require.NoError(t, err)
+	defer os.RemoveAll(path)
+
+	b, err := NewBoltStorage(&BoltStorageConfig{
