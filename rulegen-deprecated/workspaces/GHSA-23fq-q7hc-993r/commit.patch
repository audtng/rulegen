new file mode 100644
index 00000000000..114f596f9ab
--- /dev/null
+++ b/helper/hostutil/hostinfo_util.go
@@ -0,0 +1,24 @@
+package hostutil
+
+// VirutalMemoryStat holds commonly used memory measurements. We must have a
+// local type here in order to avoid building the gopsutil library on certain
+// arch types.
+type VirtualMemoryStat struct {
+	// Total amount of RAM on this system
+	Total uint64
+
+	// RAM available for programs to allocate
+	//
+	// This value is computed from the kernel specific values.
+	Available uint64
+
+	// RAM used by programs
+	//
+	// This value is computed from the kernel specific values.
+	Used uint64
+
+	// Percentage of RAM used by programs
+	//
+	// This value is computed from the kernel specific values.
+	UsedPercent float64
+}
