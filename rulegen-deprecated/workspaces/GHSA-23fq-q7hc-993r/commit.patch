+func CollectHostMemory(ctx context.Context) (*VirtualMemoryStat, error) {
+	m, err := mem.VirtualMemoryWithContext(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	return &VirtualMemoryStat{
+		Total:       m.Total,
+		Available:   m.Available,
+		Used:        m.Used,
+		UsedPercent: m.UsedPercent,
+	}, nil
+}
