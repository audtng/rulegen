+	})
+	require.NoError(t, err)
+
+	token, err := b.GetAutoAuthToken(ctx)
+	assert.NoError(t, err)
+	assert.Nil(t, token)
+
+	// set first token
+	err = b.Set(ctx, "token-test1", []byte("hello 1"), TokenType)
+	require.NoError(t, err)
