+func (b *BoolPtr) Set(v string) error {
+	val, err := strconv.ParseBool(v)
+	if err != nil {
+		return err
+	}
+
+	if b.v == nil {
+		b.v = new(bool)
+	}
+	*b.v = val
+
+	return nil
+}
+
+func (b *BoolPtr) IsSet() bool {
+	return b.v != nil
+}
+
+func (b *BoolPtr) Get() bool {
+	if b.v == nil {
