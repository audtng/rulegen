diff --git a/packages/grafana-ui/src/Intro.story.mdx b/packages/grafana-ui/src/Intro.story.mdx
index a4aa4b04d0bc5..11411323643d6 100644
--- a/packages/grafana-ui/src/Intro.story.mdx
