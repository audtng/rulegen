+// 401: unauthorisedError
+// 403: forbiddenError
+// 404: notFoundError
+// 500: internalServerError
+
+// swagger:route POST /alerts/test legacy_alerts testAlert
+//
+// Test alert.
+//
+// Responses:
+// 200: testAlertResponse
+// 400: badRequestError
+// 422: unprocessableEntityError
+// 403: forbiddenError
+// 500: internalServerError
