+
+export function useFocus(): [RefObject<HTMLInputElement>, () => void] {
+  const ref = useRef<HTMLInputElement>(null);
+  const setFocus = () => {
+    ref.current && ref.current.focus();
+  };
+  return [ref, setFocus];
+}
