+
+describe('field convert type', () => {
+  it('will parse properly formatted strings to time', () => {
+    const options = { targetField: 'proper dates', destinationType: FieldType.time };
+
+    const stringTime = {
+      name: 'proper dates',
+      type: FieldType.string,
+      values: new ArrayVector([
