-      libdl.so.2 => /lib/x86_64-linux-gnu/libdl.so.2 (0x00007f2047945000)
-      libpthread.so.0 => /lib/x86_64-linux-gnu/libpthread.so.0 (0x00007f2047924000)
-      librt.so.1 => /lib/x86_64-linux-gnu/librt.so.1 (0x00007f204791a000)
