+
+	cfg := &gossh.ClientConfig{}
+	cfg, err := h.SetHostKeyCallback(cfg)
+	require.NoError(t, err)
+	assert.NotNil(t, cfg.HostKeyCallback)
+}
+
+func TestClientConfigMethodValue(t *testing.T) {
+	t.Parallel()
+
+	a := &Password{
+		User:     "git",
