+func TestAlternatesAbsolutePathOutsideAlternatesFSRoot(t *testing.T) {
+	t.Parallel()
+
+	base := t.TempDir()
+	altRoot := filepath.Join(base, "alt-root")
+	outsideObjects := filepath.Join(base, "outside", ".git", "objects")
+
