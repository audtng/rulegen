index 0000000000..c2a61fcf34
--- /dev/null
+++ b/client/httplib/httpclient.go
@@ -0,0 +1,174 @@
+// Copyright 2020 beego
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
