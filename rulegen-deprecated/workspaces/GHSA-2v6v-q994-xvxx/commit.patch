+	v := "smallfish"
+	resp := &respCarrier{}
+	err = client.Get(resp, "/get", WithParam("username", v))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Log(resp.String())
+
+	n := strings.Index(resp.String(), v)
+	if n == -1 {
