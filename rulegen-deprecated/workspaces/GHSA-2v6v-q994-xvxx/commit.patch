+	s.Mock(MockRead((&User{}).TableName(), func(data interface{}) {
+		u := data.(*User)
+		u.Name = "Tom"
+	}, mock))
+	u, err := originalTxUsingClosure()
+	assert.Equal(t, mock, err)
+	assert.Equal(t, "Tom", u.Name)
+}
