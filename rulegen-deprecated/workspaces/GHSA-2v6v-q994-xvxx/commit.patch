+	Author string  `json:"author" yaml:"author" xml:"author,attr"`
+	Date   string  `json:"date" yaml:"date" xml:"date,attr"`
+	Slides []slide `json:"slides" yaml:"slides" xml:"slide"`
+}
+
+type slide struct {
