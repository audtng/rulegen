diff --git a/core/berror/codes.go b/core/berror/codes.go
new file mode 100644
index 0000000000..b6712a847d
--- /dev/null
+++ b/core/berror/codes.go
@@ -0,0 +1,86 @@
+// Copyright 2020 beego
