+	err := os.WriteFile(pubKeyPath, []byte(pubKey), 0600)
+	require.NoError(t, err)
+	privKeyPath := filepath.Join(workDir, "priv.key")
+	err = os.WriteFile(privKeyPath, []byte(privKey), 0600)
