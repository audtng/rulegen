+	for _, part := range strings.Split(strings.TrimPrefix(path, Delimiter), Delimiter) {
+		if strings.TrimSpace(part) == "" {
+			return ErrEmptyPathPart
+		}
+
+		if len(part) > maxPathPartLength {
+			return ErrPathPartTooLong
+		}
+	}
