+	Type         string       `json:"type"`
+	Info         PluginInfo   `json:"info"`
+	Dependencies Dependencies `json:"dependencies"`
+}
+
+type Dependencies struct {
+	GrafanaVersion string             `json:"grafanaVersion"`
+	Plugins        []PluginDependency `json:"plugins"`
