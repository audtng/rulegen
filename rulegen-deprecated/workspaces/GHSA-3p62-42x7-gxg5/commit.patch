+	"github.com/grafana/grafana/pkg/build/syncutil"
+	"github.com/urfave/cli/v2"
+)
+
+func BuildInternalPlugins(c *cli.Context) error {
+	cfg := config.Config{
+		NumWorkers: c.Int("jobs"),
+	}
+
+	const grafanaDir = "."
+	metadata, err := GenerateMetadata(c)
+	if err != nil {
+		return err
+	}
