+	passPhrasePath := filepath.Join(workDir, "passphrase")
+	err = os.WriteFile(passPhrasePath, []byte(passPhrase), 0600)
+	require.NoError(t, err)
+	err = os.Mkdir(filepath.Join(repoDir, "repodata"), 0700)
