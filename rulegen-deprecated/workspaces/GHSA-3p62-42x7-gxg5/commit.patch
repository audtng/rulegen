+			GPGPrivateKey: privKeyPath,
+			GPGPublicKey:  pubKeyPath,
+			GPGPassPath:   passPhrasePath,
+		},
+	}
+
+	err = signRPMRepo(repoDir, cfg)
+	require.NoError(t, err)
+}
