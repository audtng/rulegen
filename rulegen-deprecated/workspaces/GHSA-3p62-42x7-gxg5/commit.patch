-	defer func() {
-		err = dst.Close()
-	}()
-
-	src, err := file.Open()
-	if err != nil {
-		return errutil.Wrap("failed to extract file", err)
-	}
-	defer func() {
-		err = src.Close()
-	}()
-
-	_, err = io.Copy(dst, src)
