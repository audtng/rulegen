+                text: '128',
+                suffix: 'km/h',
+              }}
+            />
+          }
+          ariaLabel="Menu header"
+        >
+          <Menu.Group label="Group 1">
+            <Menu.Item label="item1" icon="history" />
+            <Menu.Item label="item2" icon="filter" />
+          </Menu.Group>
+          <Menu.Group label="Group 2">
+            <Menu.Item label="item1" icon="history" />
+          </Menu.Group>
+        </Menu>
+      </StoryExample>
+      <StoryExample name="With submenu">
+        <Menu>
+          <Menu.Item label="item1" icon="history" />
+          <Menu.Item
+            label="item2"
+            icon="apps"
+            childItems={[
