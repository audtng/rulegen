rules:
  - id: archive-path-traversal
    mode: taint
    severity: ERROR
    languages:
      - go
    message: "Potential Zip Slip or Tar Slip path traversal vulnerability detected during archive extraction."
    metadata:
      category: security
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A05:2017 - Broken Access Control"
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://owasp.org/www-community/attacks/Path_Traversal"
        - "https://snyk.io/research/zip-slip-vulnerability"
      confidence: HIGH
      impact: HIGH
      likelihood: MEDIUM
      subcategory:
        - vuln
      technology:
        - go
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - pattern: '($HDR : *tar.Header).Name'
      - pattern: '($HDR : tar.Header).Name'
      - pattern: '($FILE : *zip.File).Name'
      - pattern: '($FILE : zip.File).Name'
      - pattern: '($FILE : *zip.FileHeader).Name'
      - pattern: '($FILE : zip.FileHeader).Name'
      - pattern: '($TR : *tar.Reader).Next()'
      - pattern: '($TR : tar.Reader).Next()'
      - pattern: '($ZR : *zip.Reader).File'
      - pattern: '($ZR : zip.Reader).File'
      - pattern: '($ZR : *zip.ReadCloser).File'
      - pattern: '($ZR : zip.ReadCloser).File'
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: strings.HasPrefix($TARGET, ...)
              - pattern: strings.HasPrefix(filepath.Clean($TARGET), ...)
              - pattern: strings.HasPrefix(path.Clean($TARGET), ...)
              - pattern: filepath.Rel($BASE, $TARGET)
          - focus-metavariable: $TARGET
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Create($PATH)
              - pattern: os.CreateTemp($PATH, ...)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Rename($PATH, ...)
              - pattern: os.Rename(..., $PATH)
          - focus-metavariable: $PATH
