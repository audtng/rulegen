rules:
  - id: untrusted-config-command-injection
    mode: taint
    severity: ERROR
    message: >-
      Untrusted configuration data unmarshaled from JSON/YAML/XML/TOML is passed directly into 
      command execution arguments without sanitization, leading to argument injection. 
      Because Go's exec.Command does not invoke a shell, standard escaping functions like 
      strconv.Quote do NOT prevent this vulnerability. An attacker can inject arbitrary flags 
      (e.g., --sandbox=none). To mitigate this, enforce a strict allowlist of permitted 
      arguments or disable the passing of arbitrary extra arguments entirely.
    languages:
      - go
    options:
      taint_assume_safe_booleans: true
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    metadata:
      category: security
      cwe:
        - "CWE-88: Improper Neutralization of Argument Delimiters in a Command ('Argument Injection')"
        - "CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"
      owasp:
        - "A03:2021 - Injection"
      references:
        - "https://cwe.mitre.org/data/definitions/88.html"
        - "https://cwe.mitre.org/data/definitions/78.html"
        - "https://owasp.org/Top10/A03_2021-Injection/"
        - "https://github.com/advisories/GHSA-2gv2-cffp-j227"
      confidence: MEDIUM
    pattern-sources:
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: json.Unmarshal($DATA, &$TARGET)
              - pattern: json.Unmarshal($DATA, $TARGET)
              - pattern: yaml.Unmarshal($DATA, &$TARGET)
              - pattern: yaml.Unmarshal($DATA, $TARGET)
              - pattern: xml.Unmarshal($DATA, &$TARGET)
              - pattern: xml.Unmarshal($DATA, $TARGET)
              - pattern: toml.Unmarshal($DATA, &$TARGET)
              - pattern: toml.Unmarshal($DATA, $TARGET)
              - pattern: $DEC.Decode(&$TARGET)
              - pattern: $DEC.Decode($TARGET)
          - focus-metavariable: $TARGET
    pattern-propagators:
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
      - from: $FROM
        to: strings.Split(...)
        patterns:
          - pattern: strings.Split($FROM, ...)
      - from: $FROM
        to: strings.Fields(...)
        patterns:
          - pattern: strings.Fields($FROM)
      - from: $FROM
        to: strings.Join(...)
        patterns:
          - pattern: strings.Join($FROM, ...)
          - pattern: strings.Join(..., $FROM)
      - from: $FROM
        to: $TO
        patterns:
          - pattern: $TO = append($TO, ..., $FROM, ...)
          - pattern: $TO = append($TO, $FROM...)
    pattern-sanitizers:
      # Removed strconv.Quote and regexp.QuoteMeta as they do NOT prevent Argument Injection in Go
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: isAllowed($X, ...)
              - pattern: validateArg($X, ...)
              - pattern: checkAllowlist($X, ...)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              # Catch variadic slice expansion (Highest risk - full flag injection)
              - pattern: exec.Command($BIN, ..., $ARG...)
              - pattern: exec.CommandContext($CTX, $BIN, ..., $ARG...)
              # Catch single injected arguments
              - pattern: exec.Command($BIN, ..., $ARG, ...)
              - pattern: exec.CommandContext($CTX, $BIN, ..., $ARG, ...)
              # Syscall sinks (Syscalls directly take string slices for args)
              - pattern: syscall.Exec($BIN, $ARG, ...)
              - pattern: syscall.ForkExec($BIN, $ARG, ...)
              - pattern: syscall.StartProcess($BIN, $ARG, ...)
              - pattern: os.StartProcess($BIN, $ARG, ...)
              # Struct field sinks
              - pattern: $CMD.Args = $ARG
              - pattern: $CMD.Args = append($CMD.Args, ..., $ARG, ...)
              - pattern: $CMD.Args = append($CMD.Args, $ARG...)
              - pattern: 'exec.Cmd{..., Path: $ARG, ...}'
              - pattern: 'exec.Cmd{..., Args: $ARG, ...}'
          - focus-metavariable: $ARG
