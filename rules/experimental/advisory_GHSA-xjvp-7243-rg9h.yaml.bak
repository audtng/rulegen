rules:
  - id: generic-path-traversal
    mode: taint
    severity: ERROR
    message: "Untrusted input used in file path operation without adequate validation may allow path traversal."
    languages:
      - go
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    metadata:
      category: security
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A05:2017 - Broken Access Control"
      references:
        - https://cwe.mitre.org/data/definitions/22.html
        - https://owasp.org/www-community/attacks/Path_Traversal
      technology:
        - go
      confidence: HIGH
      subcategory:
        - vuln
      impact: HIGH
      likelihood: HIGH
    pattern-sources:
      - pattern: '($R : *bufio.Reader).ReadString(...)'
      - pattern: '($R : *bufio.Reader).ReadBytes(...)'
      - pattern: '($R : *bufio.Reader).ReadLine()'
      - pattern: '($S : *bufio.Scanner).Text()'
      - pattern: '($S : *bufio.Scanner).Bytes()'
      - pattern: io.ReadAll(...)
      - pattern: os.Args
      - pattern: flag.Arg(...)
      - pattern: flag.Args()
      - pattern: '($S : ssh.Session).Command()'
      - pattern: '($S : *ssh.Session).Command()'
      - pattern: '($REQ : *ssh.Request).Payload'
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: '($C : net.Conn).Read($BUF)'
              - pattern: '($R : io.Reader).Read($BUF)'
          - focus-metavariable: $BUF
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
      - from: $FROM
        to: string(...)
        patterns:
          - pattern: string($FROM)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Open($PATH)
              - pattern: os.Create($PATH)
              - pattern: os.ReadFile($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.ReadDir($PATH)
              - pattern: os.Chtimes($PATH, ...)
              - pattern: filepath.Glob($PATH)
          - focus-metavariable: $PATH
