rules:
  - id: url-path-traversal-resolve-reference
    mode: taint
    severity: ERROR
    message: "Untrusted input used in URL ResolveReference may lead to path traversal and endpoint escape"
    languages:
      - go
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
      category: security
      technology:
        - go
        - net/http
        - gin
        - echo
        - fiber
      subcategory:
        - vuln
      confidence: HIGH
      likelihood: MEDIUM
      impact: HIGH
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
        - "https://pkg.go.dev/net/url#URL.ResolveReference"
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - pattern: '($REQ : *http.Request).URL.Query().Get(...)'
      - pattern: '($REQ : *http.Request).FormValue(...)'
      - pattern: '(*gin.Context).Query(...)'
      - pattern: '($CTX : *gin.Context).Query(...)'
      - pattern: '($CTX : *GinContext).Query(...)'
      - pattern: '(echo.Context).FormValue(...)'
      - pattern: '($CTX : echo.Context).FormValue(...)'
      - pattern: '($CTX : EchoContext).FormValue(...)'
      - pattern: '(*fiber.Ctx).Query(...)'
      - pattern: '($CTX : *fiber.Ctx).Query(...)'
      - pattern: '($CTX : *FiberCtx).Query(...)'
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: json.Unmarshal($DATA, &$TARGET)
              - pattern: yaml.Unmarshal($DATA, &$TARGET)
          - focus-metavariable: $TARGET
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
      - from: $FROM
        to: url.Parse(...)
        patterns:
          - pattern: url.Parse($FROM)
      - from: $FROM
        to: url.ParseRequestURI(...)
        patterns:
          - pattern: url.ParseRequestURI($FROM)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - pattern: url.PathEscape(...)
      - pattern: url.QueryEscape(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: $BASE.ResolveReference($TARGET)
              - pattern: '(*gin.Context).File($TARGET)'
              - pattern: '($CTX : *gin.Context).File($TARGET)'
              - pattern: '($CTX : *GinContext).File($TARGET)'
              - pattern: '(echo.Context).File($TARGET)'
              - pattern: '($CTX : echo.Context).File($TARGET)'
              - pattern: '($CTX : EchoContext).File($TARGET)'
              - pattern: '(*fiber.Ctx).SendFile($TARGET)'
              - pattern: '($CTX : *fiber.Ctx).SendFile($TARGET)'
              - pattern: '($CTX : *FiberCtx).SendFile($TARGET)'
          - focus-metavariable: $TARGET
