rules:
  - id: go-server-arbitrary-file-write
    mode: taint
    severity: ERROR
    message: "Untrusted input from server connection used in file operations or database execution, potentially leading to arbitrary file write or path traversal."
    languages:
      - go
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
        - "CWE-73: External Control of File Name or Path"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A04:2021 - Insecure Design"
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://cwe.mitre.org/data/definitions/73.html"
        - "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
      category: security
      technology:
        - go
      confidence: MEDIUM
      subcategory:
        - vuln
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: "($CONN : net.Conn).Read($BUF)"
              - pattern: "($CONN : *net.TCPConn).Read($BUF)"
              - pattern: "$CONN.Read($BUF)"
          - focus-metavariable: $BUF
      - pattern: $READER.ReadString(...)
      - pattern: $READER.ReadBytes(...)
      - pattern: $READER.ReadLine(...)
      - pattern: $READER.ReadSlice(...)
      - pattern: $SCANNER.Text(...)
      - pattern: $SCANNER.Bytes(...)
      - pattern: io.ReadAll(...)
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Create($PATH)
              - pattern: os.CreateTemp($PATH, ...)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Remove($PATH)
              - pattern: $DB.Exec($PATH, ...)
              - pattern: $DB.ExecContext($CTX, $PATH, ...)
              - pattern: $CONN.ExecContext($CTX, $PATH, ...)
              - pattern: $TX.Exec($PATH, ...)
              - pattern: $TX.ExecContext($CTX, $PATH, ...)
              - pattern: sql.Open($DRIVER, $PATH, ...)
          - focus-metavariable: $PATH
