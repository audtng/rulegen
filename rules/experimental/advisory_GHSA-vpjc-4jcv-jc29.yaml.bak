rules:
  - id: path-traversal
    mode: taint
    severity: ERROR
    message: "Potential path traversal vulnerability via untrusted input used in filesystem operation"
    languages:
      - go
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
      category: security
      confidence: HIGH
      references:
        - https://cwe.mitre.org/data/definitions/22.html
        - https://owasp.org/www-community/attacks/Path_Traversal
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: "($CONN : net.Conn).Read($BUF)"
              - pattern: "($CONN : *net.TCPConn).Read($BUF)"
              - pattern: "($CONN : *net.UDPConn).Read($BUF)"
              - pattern: "($CONN : io.Reader).Read($BUF)"
          - focus-metavariable: $BUF
      - patterns:
          - pattern-either:
              - pattern: "($R : *bufio.Reader).ReadString(...)"
              - pattern: "($R : *bufio.Reader).ReadBytes(...)"
              - pattern: "($R : *bufio.Reader).ReadLine(...)"
              - pattern: "($S : *bufio.Scanner).Text()"
              - pattern: "($S : *bufio.Scanner).Bytes()"
              - pattern: io.ReadAll(...)
              - pattern: ioutil.ReadAll(...)
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: json.Unmarshal($DATA, &$TARGET)
              - pattern: json.Unmarshal($DATA, $TARGET)
              - pattern: yaml.Unmarshal($DATA, &$TARGET)
              - pattern: yaml.Unmarshal($DATA, $TARGET)
              - pattern: xml.Unmarshal($DATA, &$TARGET)
              - pattern: xml.Unmarshal($DATA, $TARGET)
              - pattern: "($DEC : *json.Decoder).Decode(&$TARGET)"
              - pattern: "($DEC : *json.Decoder).Decode($TARGET)"
              - pattern: "($DEC : *xml.Decoder).Decode(&$TARGET)"
              - pattern: "($DEC : *xml.Decoder).Decode($TARGET)"
          - focus-metavariable: $TARGET
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Open($PATH)
              - pattern: os.Create($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.ReadFile($PATH)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: ioutil.ReadFile($PATH)
              - pattern: ioutil.WriteFile($PATH, ...)
          - focus-metavariable: $PATH
