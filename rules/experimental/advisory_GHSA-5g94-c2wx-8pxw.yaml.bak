rules:
  - id: archive-path-traversal
    mode: taint
    severity: ERROR
    message: "Untrusted file path from archive entry (tar or zip) is used in a filesystem operation without validation, leading to path traversal (Zip Slip)."
    languages:
      - go
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
      category: security
      confidence: HIGH
      subcategory:
        - vuln
      impact: HIGH
      likelihood: MEDIUM
      references:
        - https://cwe.mitre.org/data/definitions/22.html
        - https://owasp.org/www-community/attacks/Path_Traversal
        - https://snyk.io/research/zip-slip-vulnerability
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - pattern: "($HDR : *tar.Header).Name"
      - pattern: "($HDR : tar.Header).Name"
      - pattern: "($HDR : *tar.Header).Linkname"
      - pattern: "($HDR : tar.Header).Linkname"
      - pattern: "($FILE : *zip.File).Name"
      - pattern: "($FILE : zip.File).Name"
      - pattern: "($FH : *zip.FileHeader).Name"
      - pattern: "($FH : zip.FileHeader).Name"
      - pattern: "($TR : *tar.Reader).Next()"
      - pattern: "($ZR : *zip.Reader).File"
      - pattern: "($ZR : *zip.ReadCloser).File"
      - patterns:
          - pattern: $TR.Next()
          - pattern-either:
              - pattern-inside: |
                  $TR := tar.NewReader(...)
                  ...
              - pattern-inside: |
                  $TR = tar.NewReader(...)
                  ...
      - patterns:
          - pattern: $ZR.File
          - pattern-either:
              - pattern-inside: |
                  $ZR, ... := zip.OpenReader(...)
                  ...
              - pattern-inside: |
                  $ZR, ... = zip.OpenReader(...)
                  ...
              - pattern-inside: |
                  $ZR, ... := zip.NewReader(...)
                  ...
              - pattern-inside: |
                  $ZR, ... = zip.NewReader(...)
                  ...
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Create($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.ReadFile($PATH)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.Symlink(..., $PATH)
              - pattern: os.Symlink($PATH, ...)
              - pattern: os.Link(..., $PATH)
              - pattern: os.Link($PATH, ...)
              - pattern: os.Chmod($PATH, ...)
              - pattern: os.Chown($PATH, ...)
              - pattern: os.Chtimes($PATH, ...)
              - pattern: os.Truncate($PATH, ...)
              - pattern: os.ReadDir($PATH)
              - pattern: os.DirFS($PATH)
              - pattern: ioutil.WriteFile($PATH, ...)
              - pattern: ioutil.ReadFile($PATH)
          - focus-metavariable: $PATH
