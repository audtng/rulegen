rules:
  - id: archive-path-traversal
    mode: taint
    severity: ERROR
    message: >-
      Unsanitized archive entry path is used directly in a filesystem operation.
      Extracting archive files (such as zip or tar) using entry names without verifying
      that the destination path stays within the target directory can allow arbitrary file overwrite (Archive/Zip Slip).
      Ensure the entry path is validated with filepath.IsLocal, sanitized with filepath.Base,
      or verified to reside within the destination directory with proper separator checks.
    languages:
      - go
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A05:2017 - Broken Access Control"
      category: security
      technology:
        - go
      references:
        - https://cwe.mitre.org/data/definitions/22.html
        - https://owasp.org/www-community/attacks/Path_Traversal
        - https://security.snyk.io/research/zip-slip-vulnerability
    pattern-sources:
      - pattern: "($F : *zip.File).Name"
      - pattern: "($F : zip.File).Name"
      - pattern: "($F : *zip.FileHeader).Name"
      - pattern: "($F : zip.FileHeader).Name"
      - pattern: "($H : *tar.Header).Name"
      - pattern: "($H : tar.Header).Name"
      - pattern: "($H : *tar.Header).Linkname"
      - pattern: "($H : tar.Header).Linkname"
      - patterns:
          - pattern-inside: |
              for ..., $F := range $R.File {
                ...
              }
          - pattern: $F.Name
      - patterns:
          - pattern-inside: |
              $H, ... := $TR.Next()
              ...
          - pattern: $H.Name
      - patterns:
          - pattern-inside: |
              $H, ... = $TR.Next()
              ...
          - pattern: $H.Name
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: strings.HasPrefix($X, $DIR + string(os.PathSeparator))
              - pattern: strings.HasPrefix($X, $DIR + string(filepath.Separator))
              - pattern: strings.HasPrefix($X, $DIR + "/")
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Create($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: ioutil.WriteFile($PATH, ...)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Truncate($PATH, ...)
              - pattern: os.Symlink(..., $PATH)
          - focus-metavariable: $PATH
