rules:
  - id: http-identity-header-spoofing
    mode: search
    languages:
      - go
    severity: ERROR
    message: "Detected potential authentication bypass or user impersonation via unverified HTTP identity headers. Relying on caller-supplied HTTP headers (such as X-Forwarded-User, X-Remote-User, X-User-Id, or custom identity headers) to determine user identity, owner, or tenant without verifying proxy authenticity or mutual TLS allows attackers to spoof identities and bypass access controls."
    metadata:
      cwe:
        - "CWE-287: Improper Authentication"
      owasp:
        - "A07:2021 - Identification and Authentication Failures"
      category: security
      confidence: HIGH
      references:
        - "https://cwe.mitre.org/data/definitions/287.html"
        - "https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures/"
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    patterns:
      - pattern-either:
          # Pattern 1: Setting identity field in struct initialization from untrusted header
          - patterns:
              - pattern-either:
                  - pattern: |
                      &$T{
                        ...,
                        $FIELD: $REQ.Header.Get($HEADER),
                        ...
                      }
                  - pattern: |
                      $T{
                        ...,
                        $FIELD: $REQ.Header.Get($HEADER),
                        ...
                      }
              - metavariable-regex:
                  metavariable: $FIELD
                  regex: (?i)^(User|Username|UserID|Owner|Org|Identity|Subject|Account|Principal)$
              - metavariable-regex:
                  metavariable: $HEADER
                  regex: (?i)^"(x-.*|cf-access-.*)"$
              - pattern-not-inside: |
                  if ! $CHECK($REQ.RemoteAddr) {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if ! $CHECK($REQ.RemoteAddr, ...) {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if $CHECK($REQ.RemoteAddr) {
                    ...
                  }
              - pattern-not-inside: |
                  if $CHECK($REQ.RemoteAddr, ...) {
                    ...
                  }
              - pattern-not-inside: |
                  if $REQ.TLS == nil {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if $REQ.TLS != nil {
                    ...
                  }

          # Pattern 2: Assigning untrusted identity header to session/auth struct field
          - patterns:
              - pattern: $SESSION.$FIELD = $REQ.Header.Get($HEADER)
              - metavariable-regex:
                  metavariable: $FIELD
                  regex: (?i)^(User|Username|UserID|Owner|Org|Identity|Subject|Account|Principal)$
              - metavariable-regex:
                  metavariable: $HEADER
                  regex: (?i)^"(x-.*|cf-access-.*)"$
              - pattern-not-inside: |
                  if ! $CHECK($REQ.RemoteAddr) {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if ! $CHECK($REQ.RemoteAddr, ...) {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if $CHECK($REQ.RemoteAddr) {
                    ...
                  }
              - pattern-not-inside: |
                  if $CHECK($REQ.RemoteAddr, ...) {
                    ...
                  }
              - pattern-not-inside: |
                  if $REQ.TLS == nil {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if $REQ.TLS != nil {
                    ...
                  }

          # Pattern 3: Extracting well-known proxy/identity authentication headers into variable or context
          - patterns:
              - pattern-either:
                  - pattern: $USER := $REQ.Header.Get($HEADER)
                  - pattern: $USER = $REQ.Header.Get($HEADER)
                  - pattern: context.WithValue($CTX, $KEY, $REQ.Header.Get($HEADER))
                  - pattern: return $REQ.Header.Get($HEADER)
              - metavariable-regex:
                  metavariable: $HEADER
                  regex: (?i)^"(x-forwarded-user|x-remote-user|x-user-id|x-auth-user|x-authenticated-user|x-webauth-user|x-proxy-user|x-original-user|x-consumer-username)"$
              - pattern-not-inside: |
                  if ! $CHECK($REQ.RemoteAddr) {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if ! $CHECK($REQ.RemoteAddr, ...) {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if $CHECK($REQ.RemoteAddr) {
                    ...
                  }
              - pattern-not-inside: |
                  if $CHECK($REQ.RemoteAddr, ...) {
                    ...
                  }
              - pattern-not-inside: |
                  if $REQ.TLS == nil {
                    ...
                    return ...
                  }
                  ...
              - pattern-not-inside: |
                  if $REQ.TLS != nil {
                    ...
                  }
