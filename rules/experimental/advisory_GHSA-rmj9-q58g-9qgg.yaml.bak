rules:
  - id: archive-path-traversal
    mode: taint
    severity: ERROR
    message: "Untrusted archive entry path used in file system operation without validation (Zip Slip / Tar Slip). An attacker can craft an archive with path traversal characters (such as '../') to write or overwrite arbitrary files outside the target directory. Validate that the extracted path resides within the intended destination directory using filepath.Rel, filepath.IsLocal, or a prefix check after cleaning."
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A05:2017 - Broken Access Control"
      category: security
      technology:
        - go
      confidence: HIGH
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
        - "https://snyk.io/research/zip-slip-vulnerability"
    languages:
      - go
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - patterns:
          - pattern-either:
              - pattern: '($F : *zip.File).Name'
              - pattern: '($F : zip.File).Name'
              - pattern: '($F : *zip.FileHeader).Name'
              - pattern: '($F : zip.FileHeader).Name'
              - pattern: '($H : *tar.Header).Name'
              - pattern: '($H : tar.Header).Name'
              - pattern: '($H : *tar.Header).Linkname'
              - pattern: '($H : tar.Header).Linkname'
              - pattern: '($R : *tar.Reader).Next()'
              - pattern: '($R : tar.Reader).Next()'
              - pattern: '($R : *zip.Reader).File'
              - pattern: '($R : zip.Reader).File'
              - pattern: '($R : *zip.ReadCloser).File'
              - pattern: '($R : zip.ReadCloser).File'
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: strings.HasPrefix($PATH, ...)
          - focus-metavariable: $PATH
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Open($PATH)
              - pattern: os.Create($PATH)
              - pattern: os.CreateTemp($PATH, ...)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.ReadFile($PATH)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Truncate($PATH, ...)
              - pattern: os.Chmod($PATH, ...)
              - pattern: os.Chown($PATH, ...)
              - pattern: os.Symlink(..., $PATH)
              - pattern: os.Link(..., $PATH)
              - pattern: os.Rename($PATH, ...)
              - pattern: os.Rename(..., $PATH)
          - focus-metavariable: $PATH
