rules:
  - id: go-path-traversal
    mode: taint
    severity: ERROR
    message: Potential path traversal via unsanitized HTTP input flowing into filesystem operations.
    languages:
      - go
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    metadata:
      category: security
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
      references:
        - "https://owasp.org/www-community/attacks/Path_Traversal"
        - "https://cwe.mitre.org/data/definitions/22.html"
      technology:
        - go
        - net/http
        - gin
        - echo
        - fiber
      confidence: HIGH
    pattern-sources:
      # net/http sources
      - pattern: '($REQ : *http.Request).URL.Path'
      - pattern: '($REQ : *http.Request).URL.RawQuery'
      - pattern: '($REQ : *http.Request).URL.Query().Get(...)'
      - pattern: '($REQ : *http.Request).URL.Query()[...]'
      - pattern: '($REQ : *http.Request).FormValue(...)'
      - pattern: '($REQ : *http.Request).PostFormValue(...)'
      - pattern: '($REQ : *http.Request).Header.Get(...)'
      - pattern: '($REQ : *http.Request).Header[...]'
      - pattern: '($REQ : *http.Request).PathValue(...)'
      - pattern: '($REQ : *http.Request).RequestURI'
      # Gin sources
      - pattern: '(*gin.Context).Query(...)'
      - pattern: '($CTX : *gin.Context).Query(...)'
      - pattern: '(*gin.Context).Param(...)'
      - pattern: '($CTX : *gin.Context).Param(...)'
      - pattern: '(*gin.Context).PostForm(...)'
      - pattern: '($CTX : *gin.Context).PostForm(...)'
      - pattern: '(*GinContext).Query(...)'
      - pattern: '($CTX : *GinContext).Query(...)'
      - pattern: '(*GinContext).Param(...)'
      - pattern: '($CTX : *GinContext).Param(...)'
      - pattern: '(*GinContext).PostForm(...)'
      - pattern: '($CTX : *GinContext).PostForm(...)'
      # Echo sources
      - pattern: '(echo.Context).FormValue(...)'
      - pattern: '($CTX : echo.Context).FormValue(...)'
      - pattern: '(echo.Context).QueryParam(...)'
      - pattern: '($CTX : echo.Context).QueryParam(...)'
      - pattern: '(echo.Context).Param(...)'
      - pattern: '($CTX : echo.Context).Param(...)'
      - pattern: '(EchoContext).FormValue(...)'
      - pattern: '($CTX : EchoContext).FormValue(...)'
      - pattern: '(*EchoContext).FormValue(...)'
      - pattern: '($CTX : *EchoContext).FormValue(...)'
      # Fiber sources
      - pattern: '(*fiber.Ctx).Query(...)'
      - pattern: '($CTX : *fiber.Ctx).Query(...)'
      - pattern: '(*fiber.Ctx).Params(...)'
      - pattern: '($CTX : *fiber.Ctx).Params(...)'
      - pattern: '(*fiber.Ctx).FormValue(...)'
      - pattern: '($CTX : *fiber.Ctx).FormValue(...)'
      - pattern: '(*FiberCtx).Query(...)'
      - pattern: '($CTX : *FiberCtx).Query(...)'
      - pattern: '(*FiberCtx).Params(...)'
      - pattern: '($CTX : *FiberCtx).Params(...)'
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
      - from: $FROM
        to: strings.Join(...)
        patterns:
          - pattern: strings.Join(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: path.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: strings.Contains($X, "..")
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Open($PATH)
              - pattern: os.Create($PATH)
              - pattern: os.ReadFile($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: ioutil.ReadFile($PATH)
              - pattern: ioutil.WriteFile($PATH, ...)
              - pattern: http.Dir($PATH)
              # Gin sinks
              - pattern: '(*gin.Context).File($PATH)'
              - pattern: '($CTX : *gin.Context).File($PATH)'
              - pattern: '(*gin.Context).FileAttachment($PATH, ...)'
              - pattern: '($CTX : *gin.Context).FileAttachment($PATH, ...)'
              - pattern: '(*gin.Context).SaveUploadedFile(..., $PATH)'
              - pattern: '($CTX : *gin.Context).SaveUploadedFile(..., $PATH)'
              - pattern: '(*GinContext).File($PATH)'
              - pattern: '($CTX : *GinContext).File($PATH)'
              - pattern: '(*GinContext).FileAttachment($PATH, ...)'
              - pattern: '($CTX : *GinContext).FileAttachment($PATH, ...)'
              - pattern: '(*GinContext).SaveUploadedFile(..., $PATH)'
              - pattern: '($CTX : *GinContext).SaveUploadedFile(..., $PATH)'
              # Echo sinks
              - pattern: '(echo.Context).File($PATH)'
              - pattern: '($CTX : echo.Context).File($PATH)'
              - pattern: '(echo.Context).Attachment($PATH, ...)'
              - pattern: '($CTX : echo.Context).Attachment($PATH, ...)'
              - pattern: '(EchoContext).File($PATH)'
              - pattern: '($CTX : EchoContext).File($PATH)'
              - pattern: '(*EchoContext).File($PATH)'
              - pattern: '($CTX : *EchoContext).File($PATH)'
              # Fiber sinks
              - pattern: '(*fiber.Ctx).SendFile($PATH, ...)'
              - pattern: '($CTX : *fiber.Ctx).SendFile($PATH, ...)'
              - pattern: '(*fiber.Ctx).Download($PATH, ...)'
              - pattern: '($CTX : *fiber.Ctx).Download($PATH, ...)'
              - pattern: '(*fiber.Ctx).SaveFile(..., $PATH)'
              - pattern: '($CTX : *fiber.Ctx).SaveFile(..., $PATH)'
              - pattern: '(*FiberCtx).SendFile($PATH, ...)'
              - pattern: '($CTX : *FiberCtx).SendFile($PATH, ...)'
          - focus-metavariable: $PATH
