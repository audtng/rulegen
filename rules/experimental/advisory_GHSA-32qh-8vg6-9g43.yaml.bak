rules:
  - id: go-archive-path-traversal
    mode: taint
    severity: ERROR
    message: >-
      Untrusted archive entry path used in file system operation without validation.
      Extracting archive files (tar/zip) using their header or file names directly in
      file system paths allows attackers to perform path traversal (Zip Slip / Tar Slip)
      and overwrite arbitrary files outside the target directory.
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A05:2021 - Security Misconfiguration"
      category: security
      confidence: HIGH
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
        - "https://snyk.io/research/zip-slip-vulnerability"
    languages:
      - go
    options:
      taint_assume_safe_booleans: true
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    pattern-sources:
      - pattern: "($HDR : *tar.Header).Name"
      - pattern: "($HDR : tar.Header).Name"
      - pattern: "($HDR : *tar.Header).Linkname"
      - pattern: "($HDR : tar.Header).Linkname"
      - pattern: "($FILE : *zip.File).Name"
      - pattern: "($FILE : zip.File).Name"
      - pattern: "($FILE : *zip.FileHeader).Name"
      - pattern: "($FILE : zip.FileHeader).Name"
      - pattern: "($TR : *tar.Reader).Next()"
      - pattern: "($TR : tar.Reader).Next()"
      - pattern: "($ZR : *zip.Reader).File"
      - pattern: "($ZR : zip.Reader).File"
      - pattern: "($ZR : *zip.ReadCloser).File"
      - pattern: "($ZR : zip.ReadCloser).File"
      - patterns:
          - pattern: $TR.Next()
          - pattern-either:
              - pattern-inside: |
                  $TR, ... := tar.NewReader(...)
                  ...
              - pattern-inside: |
                  $TR, ... = tar.NewReader(...)
                  ...
              - pattern-inside: |
                  $TR := tar.NewReader(...)
                  ...
              - pattern-inside: |
                  $TR = tar.NewReader(...)
                  ...
      - patterns:
          - pattern: $ZR.File
          - pattern-either:
              - pattern-inside: |
                  $ZR, ... := zip.OpenReader(...)
                  ...
              - pattern-inside: |
                  $ZR, ... = zip.OpenReader(...)
                  ...
              - pattern-inside: |
                  $ZR, ... := zip.NewReader(...)
                  ...
              - pattern-inside: |
                  $ZR, ... = zip.NewReader(...)
                  ...
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Dir(...)
        patterns:
          - pattern: filepath.Dir($FROM)
      - from: $FROM
        to: path.Dir(...)
        patterns:
          - pattern: path.Dir($FROM)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
      - from: $FROM
        to: strings.Join(...)
        patterns:
          - pattern: strings.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Rel(...)
        patterns:
          - pattern: filepath.Rel(..., $FROM)
      - from: $FROM
        to: filepath.Abs(...)
        patterns:
          - pattern: filepath.Abs($FROM)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - pattern: securejoin.SecureJoin(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: fs.ValidPath($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: strings.HasPrefix($X, ...)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Open($PATH)
              - pattern: os.Create($PATH)
              - pattern: os.CreateTemp($PATH, ...)
              - pattern: os.ReadFile($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Truncate($PATH, ...)
              - pattern: os.Chmod($PATH, ...)
              - pattern: os.Chown($PATH, ...)
              - pattern: os.Lchown($PATH, ...)
              - pattern: os.Chtimes($PATH, ...)
              - pattern: os.ReadDir($PATH)
              - pattern: os.Link($PATH, ...)
              - pattern: os.Link(..., $PATH)
              - pattern: os.Symlink($PATH, ...)
              - pattern: os.Symlink(..., $PATH)
              - pattern: os.Rename($PATH, ...)
              - pattern: os.Rename(..., $PATH)
              - pattern: os.DirFS($PATH)
              - pattern: ioutil.ReadFile($PATH)
              - pattern: ioutil.WriteFile($PATH, ...)
              - pattern: ioutil.ReadDir($PATH)
              - pattern: ioutil.TempFile($PATH, ...)
              - pattern: ioutil.TempDir($PATH, ...)
          - focus-metavariable: $PATH
