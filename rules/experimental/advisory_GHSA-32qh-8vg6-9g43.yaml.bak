rules:
  - id: archive-path-traversal
    mode: taint
    severity: ERROR
    message: "Untrusted archive entry path used in file system operation without validation"
    languages:
      - go
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://owasp.org/www-community/attacks/Path_Traversal"
        - "https://snyk.io/research/zip-slip-vulnerability"
      category: security
      technology:
        - go
      confidence: HIGH
      subcategory:
        - vuln
      impact: HIGH
      likelihood: MEDIUM
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - pattern: "($H : *tar.Header).Name"
      - pattern: "($H : tar.Header).Name"
      - pattern: "($H : *tar.Header).Linkname"
      - pattern: "($H : tar.Header).Linkname"
      - pattern: "($F : *zip.File).Name"
      - pattern: "($F : zip.File).Name"
      - pattern: "($FH : *zip.FileHeader).Name"
      - pattern: "($FH : zip.FileHeader).Name"
      - patterns:
          - pattern: $HDR.Name
          - pattern-inside: |
              $HDR, ... := $TR.Next(...)
              ...
      - patterns:
          - pattern: $HDR.Name
          - pattern-inside: |
              $HDR, ... = $TR.Next(...)
              ...
      - patterns:
          - pattern: $HDR.Linkname
          - pattern-inside: |
              $HDR, ... := $TR.Next(...)
              ...
      - patterns:
          - pattern: $HDR.Linkname
          - pattern-inside: |
              $HDR, ... = $TR.Next(...)
              ...
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              for ..., $F := range $ZR.File {
                ...
              }
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              for ..., $F = range $ZR.File {
                ...
              }
      - patterns:
          - pattern: ($X.(*tar.Header)).Name
      - patterns:
          - pattern: ($X.(*zip.File)).Name
      - patterns:
          - pattern: $HDR.Name
          - pattern-inside: |
              $HDR, ... := $X.(*tar.Header)
              ...
      - patterns:
          - pattern: $HDR.Name
          - pattern-inside: |
              $HDR = $X.(*tar.Header)
              ...
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              $F, ... := $X.(*zip.File)
              ...
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              $F = $X.(*zip.File)
              ...
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - pattern: securejoin.SecureJoin(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: strings.HasPrefix($PATH, ...)
          - focus-metavariable: $PATH
      - by-side-effect: true
        patterns:
          - pattern: filepath.Rel(..., $PATH)
          - focus-metavariable: $PATH
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Open($PATH)
              - pattern: os.Create($PATH)
              - pattern: os.CreateTemp($PATH, ...)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Truncate($PATH, ...)
              - pattern: os.ReadFile($PATH)
              - pattern: os.ReadDir($PATH)
              - pattern: os.Chmod($PATH, ...)
              - pattern: os.Chown($PATH, ...)
              - pattern: os.Lchown($PATH, ...)
              - pattern: os.Rename($PATH, ...)
              - pattern: os.Rename(..., $PATH)
              - pattern: os.Symlink($PATH, ...)
              - pattern: os.Symlink(..., $PATH)
              - pattern: os.Link($PATH, ...)
              - pattern: os.Link(..., $PATH)
          - focus-metavariable: $PATH
