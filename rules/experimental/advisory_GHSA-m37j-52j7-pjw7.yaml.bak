rules:
  - id: go-archive-path-traversal
    mode: taint
    severity: ERROR
    message: >-
      Unsanitized path extracted from an archive header is used directly in a
      filesystem operation. This can lead to arbitrary file write or overwrite
      outside the extraction directory (Zip Slip / Tar Slip). Sanitize the path
      using filepath.Base or verify containment using filepath.IsLocal or prefix
      validation before performing filesystem operations.
    languages:
      - go
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A05:2017 - Broken Access Control"
      category: security
      technology:
        - go
        - archive
      confidence: HIGH
      subcategory:
        - vuln
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://owasp.org/www-community/attacks/Path_Traversal"
        - "https://snyk.io/research/zip-slip-vulnerability"
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - pattern: "($HDR : *tar.Header).Name"
      - pattern: "($HDR : *tar.Header).Linkname"
      - pattern: "($HDR : tar.Header).Name"
      - pattern: "($HDR : tar.Header).Linkname"
      - pattern: "($FILE : *zip.File).Name"
      - pattern: "($FILE : zip.File).Name"
      - pattern: "($FILE : *zip.FileHeader).Name"
      - pattern: "($FILE : zip.FileHeader).Name"
      - patterns:
          - pattern: $HDR.Name
          - pattern-inside: |
              $HDR, ... := ($TR : *tar.Reader).Next()
              ...
      - patterns:
          - pattern: $HDR.Linkname
          - pattern-inside: |
              $HDR, ... := ($TR : *tar.Reader).Next()
              ...
      - patterns:
          - pattern: $HDR.Name
          - pattern-inside: |
              $HDR, ... = ($TR : *tar.Reader).Next()
              ...
      - patterns:
          - pattern: $HDR.Linkname
          - pattern-inside: |
              $HDR, ... = ($TR : *tar.Reader).Next()
              ...
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              for ..., $F := range ($ZR : *zip.Reader).File {
                ...
              }
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              for ..., $F := range ($ZR : *zip.ReadCloser).File {
                ...
              }
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              $R, ... := zip.OpenReader(...)
              ...
              for ..., $F := range $R.File {
                ...
              }
      - patterns:
          - pattern: $F.Name
          - pattern-inside: |
              $R, ... := zip.NewReader(...)
              ...
              for ..., $F := range $R.File {
                ...
              }
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: strings.HasPrefix($X, ...)
          - focus-metavariable: $X
      - by-side-effect: true
        patterns:
          - pattern: strings.Contains($X, "..")
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Create($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Symlink(..., $PATH)
              - pattern: os.Link(..., $PATH)
              - pattern: os.Truncate($PATH, ...)
          - focus-metavariable: $PATH
