rules:
  - id: bcrypt-unverified-authentication
    mode: search
    languages:
      - go
    severity: ERROR
    message: "Detected unverified bcrypt authentication or missing error handling. 'bcrypt.CompareHashAndPassword' returns an error if authentication fails. Ignoring the returned error, comparing against empty passwords/hashes, or failing to return immediately upon authentication error allows unauthorized users to bypass password authentication."
    metadata:
      cwe:
        - "CWE-287: Improper Authentication"
        - "CWE-303: Incorrect Implementation of Authentication Algorithm"
      owasp:
        - "A07:2021 - Identification and Authentication Failures"
      category: security
      confidence: HIGH
      references:
        - "https://cwe.mitre.org/data/definitions/287.html"
        - "https://cwe.mitre.org/data/definitions/303.html"
        - "https://owasp.org/Top10/A07_2021-Identification_and_Authentication_Failures/"
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    patterns:
      - pattern-either:
          - pattern: _ = bcrypt.CompareHashAndPassword(...)
          - pattern: bcrypt.CompareHashAndPassword($HASH, []byte(""))
          - pattern: bcrypt.CompareHashAndPassword($HASH, []byte{})
          - pattern: bcrypt.CompareHashAndPassword($HASH, nil)
          - pattern: bcrypt.CompareHashAndPassword([]byte(""), $PASS)
          - pattern: bcrypt.CompareHashAndPassword([]byte{}, $PASS)
          - pattern: bcrypt.CompareHashAndPassword(nil, $PASS)
          - patterns:
              - pattern: $ERR := bcrypt.CompareHashAndPassword(...)
              - pattern-not-inside: |
                  $ERR := bcrypt.CompareHashAndPassword(...)
                  ...
                  if $ERR != nil { ... }
              - pattern-not-inside: |
                  $ERR := bcrypt.CompareHashAndPassword(...)
                  ...
                  if $ERR == nil { ... }
              - pattern-not-inside: |
                  $ERR := bcrypt.CompareHashAndPassword(...)
                  ...
                  return ...
          - patterns:
              - pattern: $ERR = bcrypt.CompareHashAndPassword(...)
              - pattern-not-inside: |
                  $ERR = bcrypt.CompareHashAndPassword(...)
                  ...
                  if $ERR != nil { ... }
              - pattern-not-inside: |
                  $ERR = bcrypt.CompareHashAndPassword(...)
                  ...
                  if $ERR == nil { ... }
              - pattern-not-inside: |
                  $ERR = bcrypt.CompareHashAndPassword(...)
                  ...
                  return ...
          - patterns:
              - pattern: |
                  if $ERR != nil {
                      ...
                      http.Error($W, $MSG, $CODE)
                      ...
                  }
              - pattern-inside: |
                  $ERR := bcrypt.CompareHashAndPassword(...)
                  ...
              - pattern-not: |
                  if $ERR != nil {
                      ...
                      return ...
                  }
              - metavariable-regex:
                  metavariable: $CODE
                  regex: ^(http\.StatusUnauthorized|http\.StatusForbidden|401|403)$
          - patterns:
              - pattern: |
                  if $ERR != nil {
                      ...
                      $W.WriteHeader($CODE)
                      ...
                  }
              - pattern-inside: |
                  $ERR := bcrypt.CompareHashAndPassword(...)
                  ...
              - pattern-not: |
                  if $ERR != nil {
                      ...
                      return ...
                  }
              - metavariable-regex:
                  metavariable: $CODE
                  regex: ^(http\.StatusUnauthorized|http\.StatusForbidden|401|403)$
          - patterns:
              - pattern: |
                  if err := bcrypt.CompareHashAndPassword(...); err != nil {
                      ...
                      http.Error($W, $MSG, $CODE)
                      ...
                  }
              - pattern-not: |
                  if err := bcrypt.CompareHashAndPassword(...); err != nil {
                      ...
                      return ...
                  }
              - metavariable-regex:
                  metavariable: $CODE
                  regex: ^(http\.StatusUnauthorized|http\.StatusForbidden|401|403)$
          - patterns:
              - pattern: |
                  if err := bcrypt.CompareHashAndPassword(...); err != nil {
                      ...
                      $W.WriteHeader($CODE)
                      ...
                  }
              - pattern-not: |
                  if err := bcrypt.CompareHashAndPassword(...); err != nil {
                      ...
                      return ...
                  }
              - metavariable-regex:
                  metavariable: $CODE
                  regex: ^(http\.StatusUnauthorized|http\.StatusForbidden|401|403)$
