rules:
  - id: path-traversal-unmarshaled-data
    mode: taint
    severity: ERROR
    message: >-
      Untrusted data from unmarshaled configuration or metadata is used in a
      filesystem operation without proper path sanitization, potentially
      enabling path traversal.
    languages:
      - go
    metadata:
      category: security
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
      owasp:
        - "A01:2021 - Broken Access Control"
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://owasp.org/www-community/attacks/Path_Traversal"
      confidence: MEDIUM
      likelihood: MEDIUM
      impact: HIGH
      subcategory:
        - vuln
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    pattern-sources:
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: json.Unmarshal($DATA, &$TARGET)
              - pattern: json.Unmarshal($DATA, $TARGET)
              - pattern: yaml.Unmarshal($DATA, &$TARGET)
              - pattern: yaml.Unmarshal($DATA, $TARGET)
              - pattern: xml.Unmarshal($DATA, &$TARGET)
              - pattern: xml.Unmarshal($DATA, $TARGET)
              - pattern: toml.Unmarshal($DATA, &$TARGET)
              - pattern: toml.Unmarshal($DATA, $TARGET)
              - pattern: $DEC.Decode(&$TARGET)
              - pattern: $DEC.Decode($TARGET)
          - focus-metavariable: $TARGET
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: path.Join(...)
        patterns:
          - pattern: path.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: path.Clean(...)
        patterns:
          - pattern: path.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
      - from: $FROM
        to: fmt.Sprint(...)
        patterns:
          - pattern: fmt.Sprint(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - pattern: path.Base(...)
      - by-side-effect: true
        patterns:
          - pattern: filepath.IsLocal($X)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.OpenFile($PATH, ...)
              - pattern: os.Open($PATH)
              - pattern: os.Create($PATH)
              - pattern: os.ReadFile($PATH)
              - pattern: os.WriteFile($PATH, ...)
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.Mkdir($PATH, ...)
              - pattern: os.MkdirAll($PATH, ...)
              - pattern: os.Truncate($PATH, ...)
              - pattern: os.DirFS($PATH)
              - pattern: os.ReadDir($PATH)
              - pattern: os.Rename($PATH, ...)
              - pattern: os.Rename(..., $PATH)
              - pattern: ioutil.ReadFile($PATH)
              - pattern: ioutil.WriteFile($PATH, ...)
          - focus-metavariable: $PATH
