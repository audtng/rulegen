rules:
  - id: arbitrary-file-deletion
    mode: taint
    severity: ERROR
    message: "Untrusted input flows into a file deletion or sensitive file path operation, which can allow an attacker to traverse directories and delete arbitrary files on the system."
    languages:
      - go
    paths:
      exclude:
        - "*_test.go"
        - "test/**/*.go"
        - "mock/**/*.go"
    options:
      taint_assume_safe_booleans: true
    metadata:
      cwe:
        - "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"
        - "CWE-73: External Control of File Name or Path"
      owasp:
        - "A01:2021 - Broken Access Control"
        - "A04:2021 - Insecure Design"
      category: security
      technology:
        - go
        - gin
        - echo
        - fiber
      references:
        - "https://cwe.mitre.org/data/definitions/22.html"
        - "https://cwe.mitre.org/data/definitions/73.html"
        - "https://owasp.org/Top10/A01_2021-Broken_Access_Control/"
      confidence: HIGH
      subcategory:
        - vuln
      impact: HIGH
      likelihood: HIGH
    pattern-sources:
      # net/http sources
      - pattern: "($REQ : *http.Request).URL.Query().Get(...)"
      - pattern: "($REQ : *http.Request).FormValue(...)"
      - pattern: "($REQ : *http.Request).PostFormValue(...)"
      # Gin sources
      - pattern: (*gin.Context).Query(...)
      - pattern: "($C : *gin.Context).Query(...)"
      - pattern: "($C : *gin.Context).DefaultQuery(...)"
      - pattern: "($C : *gin.Context).Param(...)"
      - pattern: "($C : *gin.Context).PostForm(...)"
      - pattern: (*GinContext).Query(...)
      - pattern: "($C : *GinContext).Query(...)"
      - pattern: "($C : *GinContext).Param(...)"
      - pattern: "($C : *GinContext).PostForm(...)"
      # Echo sources
      - pattern: (echo.Context).FormValue(...)
      - pattern: "($C : echo.Context).FormValue(...)"
      - pattern: "($C : echo.Context).QueryParam(...)"
      - pattern: (*EchoContext).FormValue(...)
      - pattern: "($C : *EchoContext).FormValue(...)"
      - pattern: "($C : *EchoContext).QueryParam(...)"
      # Fiber sources
      - pattern: (*fiber.Ctx).Query(...)
      - pattern: "($C : *fiber.Ctx).Query(...)"
      - pattern: "($C : *fiber.Ctx).Params(...)"
      - pattern: (*FiberCtx).Query(...)
      - pattern: "($C : *FiberCtx).Query(...)"
      - pattern: "($C : *FiberCtx).Params(...)"
      # Unmarshaling and web binding side-effect sources
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: json.Unmarshal($DATA, &$TARGET)
              - pattern: yaml.Unmarshal($DATA, &$TARGET)
              - pattern: "($C : *gin.Context).BindJSON(&$TARGET)"
              - pattern: "($C : *gin.Context).ShouldBindJSON(&$TARGET)"
              - pattern: "($C : *gin.Context).Bind(&$TARGET)"
              - pattern: "($C : *gin.Context).ShouldBind(&$TARGET)"
              - pattern: "($C : *gin.Context).BindQuery(&$TARGET)"
              - pattern: "($C : *gin.Context).ShouldBindQuery(&$TARGET)"
              - pattern: "($C : *GinContext).BindJSON(&$TARGET)"
              - pattern: "($C : *GinContext).ShouldBindJSON(&$TARGET)"
              - pattern: "($C : *GinContext).Bind(&$TARGET)"
              - pattern: "($C : *GinContext).ShouldBind(&$TARGET)"
              - pattern: "($C : echo.Context).Bind(&$TARGET)"
              - pattern: "($C : *EchoContext).Bind(&$TARGET)"
              - pattern: "($C : *fiber.Ctx).BodyParser(&$TARGET)"
              - pattern: "($C : *FiberCtx).BodyParser(&$TARGET)"
          - focus-metavariable: $TARGET
    pattern-propagators:
      - from: $FROM
        to: filepath.Join(...)
        patterns:
          - pattern: filepath.Join(..., $FROM, ...)
      - from: $FROM
        to: filepath.Clean(...)
        patterns:
          - pattern: filepath.Clean($FROM)
      - from: $FROM
        to: fmt.Sprintf(...)
        patterns:
          - pattern: fmt.Sprintf(..., $FROM, ...)
    pattern-sanitizers:
      - pattern: filepath.Base(...)
      - by-side-effect: true
        patterns:
          - pattern-either:
              - pattern: filepath.IsLocal($X)
              - pattern: fs.ValidPath($X)
          - focus-metavariable: $X
    pattern-sinks:
      - patterns:
          - pattern-either:
              - pattern: os.Remove($PATH)
              - pattern: os.RemoveAll($PATH)
              - pattern: os.OpenFile($PATH, ...)
              - pattern: (*gin.Context).File($PATH)
              - pattern: "($C : *gin.Context).File($PATH)"
              - pattern: (*GinContext).File($PATH)
              - pattern: "($C : *GinContext).File($PATH)"
              - pattern: (echo.Context).File($PATH)
              - pattern: "($C : echo.Context).File($PATH)"
              - pattern: (*EchoContext).File($PATH)
              - pattern: "($C : *EchoContext).File($PATH)"
              - pattern: (*fiber.Ctx).SendFile($PATH)
              - pattern: "($C : *fiber.Ctx).SendFile($PATH)"
              - pattern: (*FiberCtx).SendFile($PATH)
              - pattern: "($C : *FiberCtx).SendFile($PATH)"
          - focus-metavariable: $PATH
