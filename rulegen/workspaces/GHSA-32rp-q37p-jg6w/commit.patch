-func predFunc4VE(z *Decoder, y, x int) {
-	a := int32(z.ybr[y-1][x-1])
-	b := int32(z.ybr[y-1][x+0])
-	c := int32(z.ybr[y-1][x+1])
-	d := int32(z.ybr[y-1][x+2])
-	e := int32(z.ybr[y-1][x+3])
-	f := int32(z.ybr[y-1][x+4])
