-	bcd := uint8((b + 2*c + d + 2) / 4)
-	cde := uint8((c + 2*d + e + 2) / 4)
-	def := uint8((d + 2*e + f + 2) / 4)
-	for j := 0; j < 4; j++ {
-		z.ybr[y+j][x+0] = abc
-		z.ybr[y+j][x+1] = bcd
-		z.ybr[y+j][x+2] = cde
-		z.ybr[y+j][x+3] = def
-	}
-}
