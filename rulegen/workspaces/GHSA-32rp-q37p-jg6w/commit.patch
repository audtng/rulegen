-	for i := nTransforms - 1; i >= 0; i-- {
-		t := &transforms[i]
-		pix = inverseTransforms[t.transformType](t, pix, h)
-	}
-	return &image.NRGBA{
-		Pix:    pix,
-		Stride: 4 * int(originalW),
-		Rect:   image.Rect(0, 0, int(originalW), int(h)),
-	}, nil
