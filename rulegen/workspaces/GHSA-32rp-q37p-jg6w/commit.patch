-		}
-	case "jpeg":
-		quality := opt.Quality
-		if quality == 0 {
-			quality = defaultQuality
-		}
-
-		m = transformImage(m, opt)
-		err = jpeg.Encode(buf, m, &jpeg.Options{Quality: quality})
-		if err != nil {
-			return nil, err
-		}
-	case "png":
-		m = transformImage(m, opt)
-		err = png.Encode(buf, m)
-		if err != nil {
-			return nil, err
-		}
-	case "tiff":
-		m = transformImage(m, opt)
-		err = tiff.Encode(buf, m, &tiff.Options{Compression: tiff.Deflate, Predictor: true})
-		if err != nil {
