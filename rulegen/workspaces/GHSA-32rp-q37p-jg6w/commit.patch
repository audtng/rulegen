+		Type:        model.ChannelTypeOpen,
+	}, -1)
+	require.NoError(t, err)
+
+	userID := model.NewId()
+
+	joinTime := int64(1000)
+	err = ss.ChannelMemberHistory().LogJoinEvent(userID, channel.Id, joinTime)
