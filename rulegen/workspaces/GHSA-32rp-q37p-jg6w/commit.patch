-// decoder holds the bit-stream for a VP8L image.
-type decoder struct {
-	r     io.ByteReader
-	bits  uint32
-	nBits uint32
-}
-
-// read reads the next n bits from the decoder's bit-stream.
-func (d *decoder) read(n uint32) (uint32, error) {
-	for d.nBits < n {
-		c, err := d.r.ReadByte()
-		if err != nil {
-			if err == io.EOF {
-				err = io.ErrUnexpectedEOF
-			}
-			return 0, err
-		}
-		d.bits |= uint32(c) << d.nBits
-		d.nBits += 8
-	}
-	u := d.bits & (1<<n - 1)
-	d.bits >>= n
-	d.nBits -= n
-	return u, nil
-}
