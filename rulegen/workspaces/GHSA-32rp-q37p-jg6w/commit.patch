-// lz77Param returns the next LZ77 parameter: a length or a distance, specified
-// in section 4.2.2.
-func (d *decoder) lz77Param(symbol uint32) (uint32, error) {
-	if symbol < 4 {
-		return symbol + 1, nil
-	}
-	extraBits := (symbol - 2) >> 1
-	offset := (2 + symbol&1) << extraBits
-	n, err := d.read(extraBits)
-	if err != nil {
-		return 0, err
-	}
