-		center := (float64(x)+0.5)*scale - 0.5
-		i := int32(math.Floor(center - halfWidth))
-		if i < 0 {
-			i = 0
-		}
-		j := int32(math.Ceil(center + halfWidth))
-		if j > sw {
-			j = sw
-			if j < i {
-				j = i
-			}
-		}
-		sources[x] = source{i: i, j: j, invTotalWeight: center}
-		n += j - i
-	}
