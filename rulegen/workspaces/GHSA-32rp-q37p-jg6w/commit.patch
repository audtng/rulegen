-// DecodeConfig decodes the color model and dimensions of a VP8L image from r.
-func DecodeConfig(r io.Reader) (image.Config, error) {
-	_, w, h, err := decodeHeader(r)
-	if err != nil {
-		return image.Config{}, err
-	}
-	return image.Config{
-		ColorModel: color.NRGBAModel,
-		Width:      int(w),
-		Height:     int(h),
-	}, nil
-}
