+		first: Int = 60,
+		after: String = ""): [Channel]!
+	channelsLeft(userId: String!,
+		since: Float!): [String!]!
+	channelMembers(userId: String!,
+		channelId: String = "",
+		first: Int = 60,
+		after: String = "",
+		lastUpdateAt: Float = 0): [ChannelMember]!
+}
+
+scalar ChannelType
+
+scalar SidebarCategoryType
+
+scalar SidebarCategorySorting
+
+scalar StringMap
+
+scalar Time
+
+type Channel {
+	id           : String!
