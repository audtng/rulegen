-	contribs := make([]contrib, 0, n)
-	for k, b := range sources {
-		totalWeight := 0.0
-		l := int32(len(contribs))
-		for coord := b.i; coord < b.j; coord++ {
-			t := abs((b.invTotalWeight - float64(coord)) * kernelArgScale)
