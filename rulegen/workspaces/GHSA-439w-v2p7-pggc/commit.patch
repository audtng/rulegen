diff --git a/tests/includes/k8s.sh b/tests/includes/k8s.sh
new file mode 100644
index 000000000000..0ebca1ba2e4d
--- /dev/null
+++ b/tests/includes/k8s.sh
@@ -0,0 +1,30 @@
+kubectl() {
+	local k8s="${BOOTSTRAP_CLOUD}"
+	case "${BOOTSTRAP_PROVIDER}" in
+	"k8s")
+		;;
+	*)
+		# Use a local k8s that is available for IAAS testing needs.
+		k8s="$(default_k8s)"
+		;;
+	esac
+	case "${k8s}" in
+	"microk8s")
+		microk8s kubectl "$@"
+		;;
+	"minikube")
+		minikube kubectl -- "$@"
+		;;
+	*)
+		$(which kubectl) "$@"
+		;;
+	esac
+}
+
+default_k8s() {
+	if which "minikube" >/dev/null 2>&1; then
+		printf "minikube"
+	elif which "microk8s" >/dev/null 2>&1; then
+		printf "microk8s"
+	fi
+}
