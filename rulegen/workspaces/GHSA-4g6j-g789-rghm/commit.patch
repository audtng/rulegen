+func requestTaskSecurityServer(id, userID uint64, uuid string) *model.Server {
+	return &model.Server{
+		Common: model.Common{ID: id, UserID: userID},
+		UUID:   uuid,
+		Name:   "request-task-security-server",
+	}
+}
