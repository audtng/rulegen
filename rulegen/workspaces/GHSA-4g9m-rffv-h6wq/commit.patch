           "cf-access-authenticated-user-email": "spoof@example.com",
         },
       }),
@@ -51,7 +53,8 @@ describe("coordinator auth", () => {
     expect(shared).toMatchObject({
       authorized: true,
       admin: false,
-      owner: "operator@example.com",
+      owner: "automation@example.com",
+      org: "openclaw",
     });
     expect(admin).toMatchObject({
       authorized: true,
