 .../cluster_workflow_template_server_test.go  | 27 ++++++++++++++++
 .../workflow_template_server.go               |  8 +++++
 .../workflow_template_server_test.go          | 32 +++++++++++++++++++
 4 files changed, 75 insertions(+)

