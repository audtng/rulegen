+				MatDesc:    `{"aws:x-amz-cek-alg":"AES/GCM/NoPadding"}`,
+				KeyringAlg: "kms+context",
+				CEKAlg:     "AES/GCM/NoPadding",
+			},
+		},
+		"no json numbers": {
+			content: []byte(`{
+  "x-amz-iv": "iv",
+  "x-amz-key-v2": "key",
+  "x-amz-matdesc": "{\"aws:x-amz-cek-alg\":\"AES/GCM/NoPadding\"}",
