+func TestEnvelope_UnmarshalJSON(t *testing.T) {
+	cases := map[string]struct {
+		content  []byte
+		expected ObjectMetadata
+		actual   ObjectMetadata
+	}{
+		"string json numbers": {
+			content: []byte(`{
+  "x-amz-iv": "iv",
