+			expected: ObjectMetadata{
+				EncryptedDataKey:  "ZW5jcnlwdGVkLWtleS1kYXRh", // base64 of "encrypted-key-data"
+				MessageID:         "dGVzdC1pdi0yOC1ieXRlcy1sb25nLTEyMzQ1Njc4OTA=", // base64 of IV
+				ContentCipher:     "115",
