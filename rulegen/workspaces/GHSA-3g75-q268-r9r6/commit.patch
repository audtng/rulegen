+	sha.Write([]byte("hello"))
+	expected, _ := hex.DecodeString("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
+	b := sha.GetValue()
+
+	if !bytes.Equal(expected, b) {
