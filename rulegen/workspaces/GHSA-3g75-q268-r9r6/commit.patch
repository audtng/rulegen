+	fmt.Printf("Bucket: %s\n", bucketName)
+	fmt.Printf("Object Key: %s\n", objectKey)
+	fmt.Printf("KMS Key ID: %s\n", kmsKeyID)
+	fmt.Printf("Region: %s\n", region)
+	fmt.Println()
