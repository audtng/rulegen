+        </Bucket>
+    </Buckets>
+</ListAllMyBucketsResult>`
+				return &awstesting.MockHttpClient{
+					Response: &http.Response{
+						Status:     http.StatusText(200),
+						StatusCode: http.StatusOK,
+						Body:       io.NopCloser(strings.NewReader(mockResponse)),
