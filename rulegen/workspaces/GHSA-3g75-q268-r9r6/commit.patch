+			expected: ObjectMetadata{
+				IV:                    "iv",
+				CipherKey:             "key",
+				MatDesc:               `{"aws:x-amz-cek-alg":"AES/GCM/NoPadding"}`,
+				KeyringAlg:            "kms+context",
+				CEKAlg:                "AES/GCM/NoPadding",
+				TagLen:                "128",
+				UnencryptedContentLen: "1024",
+			},
+		},
