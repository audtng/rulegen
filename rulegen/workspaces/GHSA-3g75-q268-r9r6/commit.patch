+
+jobs:
+  unix-tests:
+    name: Unix Tests
+    runs-on: ${{ matrix.os }}
+    permissions:
+      id-token: write
+      contents: read
+    strategy:
+      matrix:
+        os: [ubuntu-latest, macos-latest]
