+
+	cases := []struct {
+		CEKAlg                   string
+		KEK, bucket, region, CEK string
+	}{
+		{
+			// AES GCM implies V2 message format
+			CEKAlg: "aes_gcm",
+			KEK:    "kms", bucket: bucket, region: region, CEK: "aes_gcm",
+		},
+	}
+
+	for _, c := range cases {
+		t.Run(c.CEKAlg, func(t *testing.T) {
+			s3Client := s3.NewFromConfig(cfg)
