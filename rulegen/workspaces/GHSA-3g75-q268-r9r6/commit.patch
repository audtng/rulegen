+				UnencryptedContentLen: "1024",
+			},
+		},
+		"integer json numbers": {
+			content: []byte(`{
+  "x-amz-iv": "iv",
+  "x-amz-key-v2": "key",
+  "x-amz-matdesc": "{\"aws:x-amz-cek-alg\":\"AES/GCM/NoPadding\"}",
+  "x-amz-wrap-alg": "kms+context",
+  "x-amz-cek-alg": "AES/GCM/NoPadding",
