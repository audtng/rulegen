From dc3d15ab6c3a69890c9985f9c875d4c2949be727 Mon Sep 17 00:00:00 2001
From: Clara Fu <cfu@pivotal.io>
Date: Thu, 21 Mar 2019 16:57:50 -0400
Subject: [PATCH] atc: better format arguments in sql queries

Signed-off-by: Clara Fu <cfu@pivotal.io>
Co-authored-by: Ciro S. Costa <cscosta@pivotal.io>
---
 atc/db/build.go                 | 4 ++--
 atc/db/resource_config_scope.go | 3 +--
 2 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/atc/db/build.go b/atc/db/build.go
index e4cbf50c801..56be700b93f 100644
--- a/atc/db/build.go
+++ b/atc/db/build.go
@@ -862,7 +862,7 @@ func (b *build) SaveOutput(
 
 	_, err = psql.Insert("build_resource_config_version_outputs").
 		Columns("resource_id", "build_id", "version_md5", "name").
-		Values(resource.ID(), strconv.Itoa(b.id), sq.Expr(fmt.Sprintf("md5('%s')", versionJSON)), sq.Expr(fmt.Sprintf("'%s'", outputName))).
+		Values(resource.ID(), strconv.Itoa(b.id), sq.Expr("md5(?)", versionJSON), outputName).
 		Suffix("ON CONFLICT DO NOTHING").
 		RunWith(tx).
 		Exec()
@@ -1040,7 +1040,7 @@ func (p *build) saveInputTx(tx Tx, buildID int, input BuildInput) error {
 
 	_, err = psql.Insert("build_resource_config_version_inputs").
 		Columns("build_id", "resource_id", "version_md5", "name").
-		Values(buildID, input.ResourceID, sq.Expr(fmt.Sprintf("md5('%s')", versionJSON)), input.Name).
+		Values(buildID, input.ResourceID, sq.Expr("md5(?)", versionJSON), input.Name).
 		Suffix("ON CONFLICT DO NOTHING").
 		RunWith(tx).
 		Exec()
diff --git a/atc/db/resource_config_scope.go b/atc/db/resource_config_scope.go
index 9f5610b7cf3..b247ba70af8 100644
--- a/atc/db/resource_config_scope.go
+++ b/atc/db/resource_config_scope.go
@@ -3,7 +3,6 @@ package db
 import (
 	"database/sql"
 	"encoding/json"
-	"fmt"
 	"time"
 
 	"code.cloudfoundry.org/lager"
@@ -119,7 +118,7 @@ func (r *resourceConfigScope) FindVersion(v atc.Version) (ResourceConfigVersion,
 		Where(sq.Eq{
 			"v.resource_config_scope_id": r.id,
 		}).
-		Where(sq.Expr(fmt.Sprintf("v.version_md5 = md5('%s')", versionByte))).
+		Where(sq.Expr("v.version_md5 = md5(?)", versionByte)).
 		RunWith(r.conn).
 		QueryRow()
 
