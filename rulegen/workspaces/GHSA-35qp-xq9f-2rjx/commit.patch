-      <td>
-        <code>myjob/dispatch-1312323423423</code>
-      </td>
-    </tr>
-    <tr>
-      <td>parent_id</td>
-      <td>myjob</td>
-    </tr>
-    <tr>
-      <td>dispatch_id</td>
-      <td>1312323423423</td>
-    </tr>
-  </tbody>
-</table>
