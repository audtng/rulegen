diff --git a/pkg/build/readlinkfs.go b/pkg/build/readlinkfs.go
deleted file mode 100644
index ce4ffacb9..000000000
--- a/pkg/build/readlinkfs.go
+++ /dev/null
@@ -1,142 +0,0 @@
-// Copyright 2022, 2023 Chainguard, Inc.
