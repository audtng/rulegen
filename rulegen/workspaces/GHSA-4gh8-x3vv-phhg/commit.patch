 go.sum                        |  4 ++--
 internal/app/siftool/modif.go | 17 +++++++++--------
 pkg/sif/create_test.go        |  9 +++++++--
 4 files changed, 19 insertions(+), 13 deletions(-)

diff --git a/go.mod b/go.mod
index 8f10b526..e85b7ea9 100644
--- a/go.mod
+++ b/go.mod
@@ -3,7 +3,7 @@ module github.com/sylabs/sif
