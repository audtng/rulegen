+// tagSplit reads the named tag from the structfield and splits its values into strings
+func tagSplit(field reflect.StructField, tagName string, vars ...*string) {
+	tag := strings.Split(field.Tag.Get(tagName), ",")
+	end := len(tag) - 1
+	for i, s := range vars {
+		if i > end {
+			return
 		}
+		*s = tag[i]
 	}
 }
