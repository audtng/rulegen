+        'nmd.one',
+        'one-alone',
+        'pre_two',
+        'hashi.two',
+        'hashi-three',
+        'nmd_two',
+        'noprefix',
+      ].forEach(name => {
+        server.create('job', { name, createAllocations: false, childrenCount: 0 });
+      });
+      await JobsList.visit();
+    },
+    filter: (job, selection) => selection.find(prefix => job.name.startsWith(prefix)),
+  });
