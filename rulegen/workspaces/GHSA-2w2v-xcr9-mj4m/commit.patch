@@ -0,0 +1,22 @@
+//+build !windows
+
+package renderer
+
+import (
+	"os"
+	"syscall"
+)
+
+func preserveFilePermissions(path string, fileInfo os.FileInfo) error {
+	sysInfo := fileInfo.Sys()
+	if sysInfo != nil {
+		stat, ok := sysInfo.(*syscall.Stat_t)
+		if ok {
+			if err := os.Chown(path, int(stat.Uid), int(stat.Gid)); err != nil {
+				return err
+			}
+		}
+	}
+
+	return nil
+}
