diff --git a/cmd/compose/config.go b/cmd/compose/config.go
index 4851e773cb4..ab6d5c583a8 100644
--- a/cmd/compose/config.go
+++ b/cmd/compose/config.go
@@ -169,6 +169,13 @@ func runConfig(ctx context.Context, dockerCli command.Cli, opts configOptions, s
 			return err
 		}
 
+		if !opts.noConsistency {
+			err := project.CheckContainerNameUnicity()
+			if err != nil {
+				return err
+			}
+		}
+
 		switch opts.Format {
 		case "json":
