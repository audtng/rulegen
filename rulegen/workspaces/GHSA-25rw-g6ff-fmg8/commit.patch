+        border-color: hsl(var(--primary)) !important;
+        background-color: hsl(var(--card)) !important; 
+    }
+
+    a.\@max-lg\:col-span-full > div:first-child {
+        @apply flex items-center gap-3;
+    }
+
+    a.\@max-lg\:col-span-full svg {
